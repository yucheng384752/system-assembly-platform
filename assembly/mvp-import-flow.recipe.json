{
  "recipeVersion": "0.1.0",
  "name": "mvp-import-flow",
  "displayName": "MVP Import Flow",
  "description": "First extraction slice: tenant/auth -> upload/validation -> import pipeline -> production records.",
  "sourceManifest": "../kits/form-analysis.kit-manifest.json",
  "database": {
    "selectedByUserIntent": {
      "usageScale": "team",
      "dataCriticality": "production",
      "needsTenantIsolation": true,
      "needsAnalytics": false,
      "needsBackgroundJobs": true
    },
    "engine": "postgresql",
    "reasonForNonTechnicalUser": "這個系統會保存正式匯入紀錄、使用者權限與背景處理結果，並支援多人共同使用，因此建議使用 PostgreSQL 作為正式資料庫。"
  },
  "enabledKits": [
    "platform-core-kit",
    "tenant-auth-kit",
    "station-data-link-kit",
    "upload-validation-kit",
    "import-pipeline-kit"
  ],
  "featureFlags": {
    "MULTI_TENANT_ENABLED": true,
    "AUTH_MODE": "api_key",
    "AUDIT_EVENTS_ENABLED": false,
    "USE_GENERIC_SCHEMA": false,
    "PDF_SERVER_URL": "required"
  },
  "frontendNavigation": [
    {
      "tab": "register",
      "labelKey": "tabs.register",
      "kit": "tenant-auth-kit"
    },
    {
      "tab": "upload",
      "labelKey": "tabs.upload",
      "kit": "upload-validation-kit"
    }
  ],
  "previewScenarios": [
    {
      "id": "mvp-upload-import",
      "label": "MVP 上傳到匯入",
      "kits": [
        "tenant-auth-kit",
        "upload-validation-kit",
        "import-pipeline-kit",
        "station-data-link-kit"
      ],
      "steps": [
        "登入租戶",
        "上傳 P1/P2/P3 CSV",
        "顯示驗證摘要",
        "建立 import job",
        "commit 到正式資料表"
      ]
    }
  ],
  "selectedSubfeatures": {
    "platform-core-kit": [
      "app-shell",
