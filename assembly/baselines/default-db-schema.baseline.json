{
  "schemaVersion": "1.0",
  "tables": {
    "tenants": {
      "kitOwner": "platform-core-kit",
      "contractStatus": "canonical",
      "columns": [
        { "name": "id",         "type": "UUID",          "nullable": false, "pk": true,  "default": "uuid4()" },
        { "name": "name",       "type": "String(100)",   "nullable": false, "unique": true },
        { "name": "code",       "type": "String(50)",    "nullable": false, "unique": true },
        { "name": "is_active",  "type": "Boolean",       "nullable": false, "default": true },
        { "name": "is_default", "type": "Boolean",       "nullable": false, "default": false },
        { "name": "created_at", "type": "DateTime(tz)",  "nullable": false, "default": "now()" },
        { "name": "updated_at", "type": "DateTime(tz)",  "nullable": false, "default": "now()", "onupdate": "now()" }
      ]
    },
    "tenant_users": {
      "kitOwner": "tenant-auth-kit",
      "contractStatus": "canonical",
      "columns": [
        { "name": "id",                   "type": "UUID",         "nullable": false, "pk": true, "default": "uuid4()" },
        { "name": "tenant_id",            "type": "UUID",         "nullable": false, "fk": "tenants.id", "index": true },
        { "name": "username",             "type": "String(100)",  "nullable": false },
        { "name": "password_hash",        "type": "String(255)",  "nullable": false },
        { "name": "must_change_password", "type": "Boolean",      "nullable": false, "default": false },
        { "name": "role",                 "type": "String(30)",   "nullable": false, "default": "user" },
        { "name": "is_active",            "type": "Boolean",      "nullable": false, "default": true },
        { "name": "created_at",           "type": "DateTime(tz)", "nullable": false, "default": "now()" },
        { "name": "last_login_at",        "type": "DateTime(tz)", "nullable": true }
      ],
      "constraints": [
        { "type": "unique", "name": "uq_tenant_users_tenant_username", "columns": ["tenant_id", "username"] }
      ]
    },
    "tenant_api_keys": {
      "kitOwner": "tenant-auth-kit",
      "contractStatus": "canonical",
      "columns": [
        { "name": "id",                             "type": "UUID",        "nullable": false, "pk": true, "default": "uuid4()" },
        { "name": "tenant_id",                      "type": "UUID",        "nullable": false, "fk": "tenants.id", "index": true },
        { "name": "user_id",                        "type": "UUID",        "nullable": true,  "fk": "tenant_users.id", "index": true },
        { "name": "key_hash",                       "type": "String(64)",  "nullable": false, "unique": true, "index": true, "note": "HMAC-SHA256 hex digest" },
        { "name": "label",                          "type": "String(100)", "nullable": false, "default": "default" },
        { "name": "is_active",                      "type": "Boolean",     "nullable": false, "default": true },
        { "name": "created_at",                     "type": "DateTime(tz)","nullable": false, "default": "now()" },
        { "name": "last_used_at",                   "type": "DateTime(tz)","nullable": true },
        { "name": "revoked_at",                     "type": "DateTime(tz)","nullable": true }
      ]
    },
    "table_registry": {
      "kitOwner": "station-data-link-kit",
      "contractStatus": "canonical",
      "columns": [
        { "name": "id",           "type": "UUID",        "nullable": false, "pk": true, "default": "uuid4()" },
        { "name": "table_code",   "type": "String(50)",  "nullable": false, "unique": true, "note": "e.g. p1_records" },
        { "name": "display_name", "type": "String(100)", "nullable": false },
        { "name": "created_at",   "type": "DateTime(tz)","nullable": false, "default": "now()" }
      ]
    },
    "schema_versions": {
      "kitOwner": "station-data-link-kit",
      "contractStatus": "canonical",
      "columns": [
        { "name": "id",                   "type": "UUID",       "nullable": false, "pk": true, "default": "uuid4()" },
        { "name": "table_id",             "type": "UUID",       "nullable": false, "fk": "table_registry.id" },
        { "name": "schema_hash",          "type": "String(64)", "nullable": false, "note": "SHA256 of schema_json" },
        { "name": "header_fingerprint",   "type": "String(64)", "nullable": false, "note": "hash of sorted headers" },
        { "name": "schema_json",          "type": "JSON",       "nullable": false },
        { "name": "created_at",           "type": "DateTime(tz)","nullable": false, "default": "now()" }
      ]
    },
    "upload_jobs": {
      "kitOwner": "upload-validation-kit",
      "contractStatus": "canonical",
      "columns": [
        { "name": "id",                              "type": "UUID",        "nullable": false, "pk": true, "default": "uuid4()" },
        { "name": "filename",                        "type": "String(255)", "nullable": false },
        { "name": "file_content",                    "type": "LargeBinary", "nullable": true },
        { "name": "created_at",                      "type": "DateTime(tz)","nullable": false, "default": "now()" },
        { "name": "tenant_id",                       "type": "UUID",        "nullable": true, "fk": "tenants.id", "index": true },
        { "name": "actor_api_key_id",                "type": "UUID",        "nullable": true, "fk": "tenant_api_keys.id", "index": true },
        { "name": "actor_label_snapshot",            "type": "String(100)", "nullable": true },
        { "name": "last_status_changed_at",          "type": "DateTime(tz)","nullable": true },
        { "name": "last_status_actor_kind",          "type": "String(20)",  "nullable": true },
        { "name": "last_status_actor_api_key_id",    "type": "UUID",        "nullable": true, "fk": "tenant_api_keys.id", "index": true },
        { "name": "last_status_actor_label_snapshot","type": "String(100)", "nullable": true },
        { "name": "status",                          "type": "ENUM[PENDING,VALIDATED,IMPORTED]", "nullable": false, "default": "PENDING" },
        { "name": "total_rows",                      "type": "Integer",     "nullable": true },
        { "name": "valid_rows",                      "type": "Integer",     "nullable": true },
        { "name": "invalid_rows",                    "type": "Integer",     "nullable": true },
        { "name": "process_id",                      "type": "UUID",        "nullable": false, "unique": true, "index": true, "default": "uuid4()" }
      ]
    },
    "import_jobs": {
      "kitOwner": "import-pipeline-kit",
      "contractStatus": "canonical",
      "columns": [
        { "name": "id",                              "type": "UUID",        "nullable": false, "pk": true, "default": "uuid4()" },
        { "name": "tenant_id",                       "type": "UUID",        "nullable": false, "fk": "tenants.id" },
        { "name": "table_id",                        "type": "UUID",        "nullable": false, "fk": "table_registry.id" },
        { "name": "schema_version_id",               "type": "UUID",        "nullable": true,  "fk": "schema_versions.id" },
        { "name": "batch_id",                        "type": "String(100)", "nullable": false, "unique": true },
        { "name": "status",                          "type": "String(20)",  "nullable": false, "default": "UPLOADED" },
        { "name": "progress",                        "type": "Integer",     "nullable": false, "default": 0 },
        { "name": "total_files",                     "type": "Integer",     "nullable": false, "default": 0 },
        { "name": "total_rows",                      "type": "Integer",     "nullable": false, "default": 0 },
        { "name": "error_count",                     "type": "Integer",     "nullable": false, "default": 0 },
        { "name": "error_summary",                   "type": "JSON",        "nullable": false, "default": "{}" },
        { "name": "created_at",                      "type": "DateTime(tz)","nullable": false, "default": "now()" },
        { "name": "updated_at",                      "type": "DateTime(tz)","nullable": false, "default": "now()", "onupdate": "now()" },
        { "name": "actor_api_key_id",                "type": "UUID",        "nullable": true, "fk": "tenant_api_keys.id", "index": true },
        { "name": "actor_label_snapshot",            "type": "String(100)", "nullable": true },
        { "name": "last_status_changed_at",          "type": "DateTime(tz)","nullable": true },
        { "name": "last_status_actor_kind",          "type": "String(20)",  "nullable": true },
        { "name": "last_status_actor_api_key_id",    "type": "UUID",        "nullable": true, "fk": "tenant_api_keys.id", "index": true },
        { "name": "last_status_actor_label_snapshot","type": "String(100)", "nullable": true }
      ]
    },
    "import_files": {
      "kitOwner": "import-pipeline-kit",
      "contractStatus": "canonical",
      "columns": [
        { "name": "id",           "type": "UUID",        "nullable": false, "pk": true, "default": "uuid4()" },
        { "name": "job_id",       "type": "UUID",        "nullable": false, "fk": "import_jobs.id", "ondelete": "CASCADE" },
        { "name": "tenant_id",    "type": "UUID",        "nullable": false, "fk": "tenants.id" },
        { "name": "table_id",     "type": "UUID",        "nullable": false, "fk": "table_registry.id" },
        { "name": "filename",     "type": "String(255)", "nullable": false },
        { "name": "file_hash",    "type": "String(64)",  "nullable": false, "note": "SHA-256" },
        { "name": "storage_path", "type": "String(512)", "nullable": false },
        { "name": "file_size",    "type": "Integer",     "nullable": false },
        { "name": "row_count",    "type": "Integer",     "nullable": false, "default": 0 },
        { "name": "created_at",   "type": "DateTime(tz)","nullable": false, "default": "now()" }
      ]
    },
    "staging_rows": {
      "kitOwner": "import-pipeline-kit",
      "contractStatus": "canonical",
      "columns": [
        { "name": "id",          "type": "UUID",    "nullable": false, "pk": true, "default": "uuid4()" },
        { "name": "job_id",      "type": "UUID",    "nullable": false, "fk": "import_jobs.id",  "ondelete": "CASCADE", "index": true },
        { "name": "file_id",     "type": "UUID",    "nullable": false, "fk": "import_files.id", "ondelete": "CASCADE" },
        { "name": "row_index",   "type": "Integer", "nullable": false, "note": "1-based row number in source file" },
        { "name": "parsed_json", "type": "JSON",    "nullable": false },
        { "name": "errors_json", "type": "JSON",    "nullable": true },
        { "name": "is_valid",    "type": "Boolean", "nullable": false, "default": true, "index": true }
      ]
    },
    "flow_runs": {
      "kitOwner": "import-pipeline-kit",
      "contractStatus": "canonical",
      "note": "One row per traceable business process run (e.g. one lot number). Created from the anchor step; other steps attach via flow_key_aliases.",
      "columns": [
        { "name": "id",             "type": "UUID",        "nullable": false, "pk": true, "default": "uuid4()" },
        { "name": "tenant_id",      "type": "UUID",        "nullable": false, "fk": "tenants.id", "index": true },
        { "name": "upload_batch_id","type": "UUID",        "nullable": true,  "fk": "import_jobs.id", "index": true, "note": "The import_job that created this flow_run" },
        { "name": "flow_key",       "type": "String(200)", "nullable": false, "note": "Primary key value from the anchor step (e.g. lot_no)" },
        { "name": "flow_key_type",  "type": "String(100)", "nullable": false, "note": "Column name that provided flow_key (e.g. 批號)" },
        { "name": "process_date",   "type": "Date",        "nullable": true,  "note": "Canonical process date detected from anchor step date column; used for display/filtering only, not for matching" },
        { "name": "status",         "type": "String(50)",  "nullable": false, "default": "partial", "note": "partial | completed | waiting_for_mapping" },
        { "name": "created_at",     "type": "DateTime(tz)","nullable": false, "default": "now()" },
        { "name": "completed_at",   "type": "DateTime(tz)","nullable": true }
      ],
      "constraints": [
        { "type": "unique", "name": "uq_flow_runs_tenant_key", "columns": ["tenant_id", "flow_key", "flow_key_type"] }
      ],
      "indexes": [
        { "name": "ix_flow_runs_tenant_date", "columns": ["tenant_id", "process_date"] }
      ]
    },
    "flow_key_aliases": {
      "kitOwner": "import-pipeline-kit",
      "contractStatus": "canonical",
      "note": "All known key values for a flow_run across different steps. Solves the cross-table key format mismatch problem.",
      "columns": [
        { "name": "id",           "type": "UUID",        "nullable": false, "pk": true, "default": "uuid4()" },
        { "name": "flow_run_id",  "type": "UUID",        "nullable": false, "fk": "flow_runs.id", "ondelete": "CASCADE", "index": true },
        { "name": "key_type",     "type": "String(100)", "nullable": false, "note": "Column name (e.g. 原料卡號, 生產批號)" },
        { "name": "key_value",    "type": "String(200)", "nullable": false, "note": "The actual key value in that step" },
        { "name": "confirmed_by", "type": "String(100)", "nullable": false, "note": "auto | user_id — auto means system inferred; user_id means manually confirmed" },
        { "name": "created_at",   "type": "DateTime(tz)","nullable": false, "default": "now()" }
      ],
      "constraints": [
        { "type": "unique", "name": "uq_flow_key_aliases_type_value", "columns": ["key_type", "key_value"] }
      ],
      "indexes": [
        { "name": "ix_flow_key_aliases_lookup", "columns": ["key_type", "key_value"] }
      ]
    },
    "trace_chains": {
      "kitOwner": "import-pipeline-kit",
      "contractStatus": "canonical",
      "note": "Identity and aggregate status of one traceable data chain. Step-level detail is in trace_chain_steps.",
      "columns": [
        { "name": "id",          "type": "UUID",        "nullable": false, "pk": true, "default": "uuid4()" },
        { "name": "flow_run_id", "type": "UUID",        "nullable": false, "fk": "flow_runs.id", "ondelete": "CASCADE", "unique": true },
        { "name": "trace_uuid",  "type": "UUID",        "nullable": false, "unique": true, "default": "uuid4()", "note": "External-facing stable identifier" },
        { "name": "chain_hash",  "type": "String(64)",  "nullable": true,  "note": "SHA256 of all completed step_hashes sorted by step_order; recomputed on each step update" },
        { "name": "status",      "type": "String(50)",  "nullable": false, "default": "partial", "note": "partial | completed | waiting_for_mapping" },
        { "name": "created_at",  "type": "DateTime(tz)","nullable": false, "default": "now()" },
        { "name": "updated_at",  "type": "DateTime(tz)","nullable": false, "default": "now()", "onupdate": "now()" }
      ]
    },
    "trace_chain_steps": {
      "kitOwner": "import-pipeline-kit",
      "contractStatus": "canonical",
      "note": "One row per step per trace chain. Dynamic — adding a new step type requires no schema change.",
      "columns": [
        { "name": "id",              "type": "UUID",        "nullable": false, "pk": true, "default": "uuid4()" },
        { "name": "trace_chain_id",  "type": "UUID",        "nullable": false, "fk": "trace_chains.id", "ondelete": "CASCADE", "index": true },
        { "name": "step_name",       "type": "String(100)", "nullable": false, "note": "e.g. daihui_entry, daihui_material" },
        { "name": "step_order",      "type": "Integer",     "nullable": false, "note": "Sort order within the chain; used when computing chain_hash" },
        { "name": "step_hash",       "type": "String(64)",  "nullable": true,  "note": "SHA256 of all row_hashes for this step; NULL if not yet uploaded" },
        { "name": "row_count",       "type": "Integer",     "nullable": true },
        { "name": "source_file_id",  "type": "UUID",        "nullable": true,  "fk": "import_files.id" },
        { "name": "status",          "type": "String(50)",  "nullable": false, "default": "pending", "note": "pending | completed | failed" },
        { "name": "completed_at",    "type": "DateTime(tz)","nullable": true }
      ],
      "constraints": [
        { "type": "unique", "name": "uq_trace_chain_steps_chain_step", "columns": ["trace_chain_id", "step_name"] }
      ]
    },
    "row_edits": {
      "kitOwner": "audit-edit-kit",
      "contractStatus": "canonical",
      "columns": [
        { "name": "id",          "type": "UUID",        "nullable": false, "pk": true, "default": "uuid4()" },
        { "name": "tenant_id",   "type": "UUID",        "nullable": false, "fk": "tenants.id", "index": true },
        { "name": "table_code",  "type": "String(50)",  "nullable": false, "index": true },
        { "name": "record_id",   "type": "UUID",        "nullable": false, "index": true },
        { "name": "reason_id",   "type": "String(100)", "nullable": true },
        { "name": "reason_text", "type": "String(255)", "nullable": true },
        { "name": "before_json", "type": "JSON",        "nullable": true },
        { "name": "after_json",  "type": "JSON",        "nullable": true },
        { "name": "created_by",  "type": "String(100)", "nullable": true },
        { "name": "created_at",  "type": "DateTime(tz)","nullable": false, "default": "now()" }
      ]
    },
    "records": {
      "kitOwner": "upload-validation-kit",
      "contractStatus": "stub",
      "note": "stub generated by assemble-system.ps1; exact columns are domain-specific",
      "columns": [
        { "name": "id",              "type": "UUID",         "nullable": false, "pk": true, "default": "uuid4()" },
        { "name": "lot_no",          "type": "String(20)",   "nullable": false, "index": true },
        { "name": "data_type",       "type": "ENUM[P1,P2,P3]","nullable": false },
        { "name": "production_date", "type": "Date",         "nullable": true },
        { "name": "additional_data", "type": "JSON",         "nullable": true },
        { "name": "machine_no",      "type": "String(50)",   "nullable": true },
        { "name": "mold_no",         "type": "String(50)",   "nullable": true },
        { "name": "production_lot",  "type": "Integer",      "nullable": true },
        { "name": "product_name",    "type": "String(200)",  "nullable": true },
        { "name": "quantity",        "type": "Integer",      "nullable": true },
        { "name": "notes",           "type": "String(1000)", "nullable": true }
      ]
    },
    "p2_items": {
      "kitOwner": "upload-validation-kit",
      "contractStatus": "stub",
      "note": "stub generated by assemble-system.ps1",
      "columns": [
        { "name": "id",              "type": "UUID",    "nullable": false, "pk": true, "default": "uuid4()" },
        { "name": "record_id",       "type": "UUID",    "nullable": false, "fk": "records.id", "ondelete": "CASCADE", "index": true },
        { "name": "winder_number",   "type": "Integer", "nullable": true },
        { "name": "sheet_width",     "type": "Float",   "nullable": true },
        { "name": "thickness1",      "type": "Float",   "nullable": true },
        { "name": "thickness2",      "type": "Float",   "nullable": true },
        { "name": "thickness3",      "type": "Float",   "nullable": true },
        { "name": "thickness4",      "type": "Float",   "nullable": true },
        { "name": "thickness5",      "type": "Float",   "nullable": true },
        { "name": "thickness6",      "type": "Float",   "nullable": true },
        { "name": "thickness7",      "type": "Float",   "nullable": true },
        { "name": "appearance",      "type": "Integer", "nullable": true },
        { "name": "rough_edge",      "type": "Integer", "nullable": true },
        { "name": "slitting_result", "type": "Integer", "nullable": true },
        { "name": "row_data",        "type": "JSON",    "nullable": true }
      ]
    },
    "p3_items": {
      "kitOwner": "import-pipeline-kit",
      "contractStatus": "stub",
      "note": "stub generated by assemble-system.ps1",
      "columns": [
        { "name": "id",              "type": "UUID",        "nullable": false, "pk": true, "default": "uuid4()" },
        { "name": "record_id",       "type": "UUID",        "nullable": false, "fk": "records.id", "ondelete": "CASCADE", "index": true },
        { "name": "product_id",      "type": "String(100)", "nullable": true },
        { "name": "lot_no",          "type": "String(20)",  "nullable": true },
        { "name": "production_lot",  "type": "Integer",     "nullable": true },
        { "name": "production_date", "type": "Date",        "nullable": true },
        { "name": "machine_no",      "type": "String(50)",  "nullable": true },
        { "name": "mold_no",         "type": "String(50)",  "nullable": true },
        { "name": "specification",   "type": "String(200)", "nullable": true },
        { "name": "bottom_tape_lot", "type": "String(100)", "nullable": true },
        { "name": "row_no",          "type": "Integer",     "nullable": true },
        { "name": "row_data",        "type": "JSON",        "nullable": true }
      ],
      "constraints": [
        { "type": "unique", "name": "uq_p3_item_record_product", "columns": ["record_id", "product_id"] }
      ]
    }
  }
}
