{
  "schemaVersion": "1.0",
  "tables": {
    "tenants": {
      "kitOwner": "platform-core-kit",
      "contractStatus": "canonical",
      "columns": [
        { "name": "id",         "type": "UUID",          "nullable": false, "pk": true,  "default": "uuid4()" },
        { "name": "name",       "type": "String(100)",   "nullable": false, "unique": true },
        { "name": "code",       "type": "String(50)",    "nullable": false, "unique": true },
        { "name": "is_active",  "type": "Boolean",       "nullable": false, "default": true },
        { "name": "is_default", "type": "Boolean",       "nullable": false, "default": false },
        { "name": "created_at", "type": "DateTime(tz)",  "nullable": false, "default": "now()" },
        { "name": "updated_at", "type": "DateTime(tz)",  "nullable": false, "default": "now()", "onupdate": "now()" }
      ]
    },
    "tenant_users": {
      "kitOwner": "tenant-auth-kit",
      "contractStatus": "canonical",
      "columns": [
        { "name": "id",                   "type": "UUID",         "nullable": false, "pk": true, "default": "uuid4()" },
        { "name": "tenant_id",            "type": "UUID",         "nullable": false, "fk": "tenants.id", "index": true },
        { "name": "username",             "type": "String(100)",  "nullable": false },
        { "name": "password_hash",        "type": "String(255)",  "nullable": false },
        { "name": "must_change_password", "type": "Boolean",      "nullable": false, "default": false },
        { "name": "role",                 "type": "String(30)",   "nullable": false, "default": "user" },
        { "name": "is_active",            "type": "Boolean",      "nullable": false, "default": true },
        { "name": "created_at",           "type": "DateTime(tz)", "nullable": false, "default": "now()" },
        { "name": "last_login_at",        "type": "DateTime(tz)", "nullable": true }
      ],
      "constraints": [
        { "type": "unique", "name": "uq_tenant_users_tenant_username", "columns": ["tenant_id", "username"] }
      ]
    },
    "tenant_api_keys": {
      "kitOwner": "tenant-auth-kit",
      "contractStatus": "canonical",
      "columns": [
        { "name": "id",                             "type": "UUID",        "nullable": false, "pk": true, "default": "uuid4()" },
        { "name": "tenant_id",                      "type": "UUID",        "nullable": false, "fk": "tenants.id", "index": true },
