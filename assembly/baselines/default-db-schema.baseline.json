        { "name": "last_used_at",                   "type": "DateTime(tz)","nullable": true },
        { "name": "revoked_at",                     "type": "DateTime(tz)","nullable": true }
      ]
    },
    "table_registry": {
      "kitOwner": "station-data-link-kit",
      "contractStatus": "canonical",
      "columns": [
        { "name": "id",           "type": "UUID",        "nullable": false, "pk": true, "default": "uuid4()" },
        { "name": "table_code",   "type": "String(50)",  "nullable": false, "unique": true, "note": "e.g. p1_records" },
        { "name": "display_name", "type": "String(100)", "nullable": false },
        { "name": "created_at",   "type": "DateTime(tz)","nullable": false, "default": "now()" }
      ]
    },
    "schema_versions": {
      "kitOwner": "station-data-link-kit",
      "contractStatus": "canonical",
      "columns": [
        { "name": "id",                   "type": "UUID",       "nullable": false, "pk": true, "default": "uuid4()" },
        { "name": "table_id",             "type": "UUID",       "nullable": false, "fk": "table_registry.id" },
        { "name": "schema_hash",          "type": "String(64)", "nullable": false, "note": "SHA256 of schema_json" },
        { "name": "header_fingerprint",   "type": "String(64)", "nullable": false, "note": "hash of sorted headers" },
        { "name": "schema_json",          "type": "JSON",       "nullable": false },
        { "name": "created_at",           "type": "DateTime(tz)","nullable": false, "default": "now()" }
      ]
    },
    "upload_jobs": {
      "kitOwner": "upload-validation-kit",
      "contractStatus": "canonical",
      "columns": [
        { "name": "id",                              "type": "UUID",        "nullable": false, "pk": true, "default": "uuid4()" },
