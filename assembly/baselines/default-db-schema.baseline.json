        { "name": "total_rows",                      "type": "Integer",     "nullable": true },
        { "name": "valid_rows",                      "type": "Integer",     "nullable": true },
        { "name": "invalid_rows",                    "type": "Integer",     "nullable": true },
        { "name": "process_id",                      "type": "UUID",        "nullable": false, "unique": true, "index": true, "default": "uuid4()" }
      ]
    },
    "import_jobs": {
      "kitOwner": "import-pipeline-kit",
      "contractStatus": "canonical",
      "columns": [
        { "name": "id",                              "type": "UUID",        "nullable": false, "pk": true, "default": "uuid4()" },
