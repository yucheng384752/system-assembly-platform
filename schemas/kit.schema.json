{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.form-system-kit-composer/schemas/kit.schema.json",
  "title": "System Kit Manifest",
  "type": "object",
  "required": [
    "manifestVersion",
    "name",
    "kits"
  ],
  "properties": {
    "manifestVersion": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "sourceSystem": {
      "type": "object"
    },
    "defaultDatabaseRecommendation": {
      "type": "object",
      "required": [
        "engine",
        "reason"
      ],
      "properties": {
        "engine": {
          "type": "string",
          "enum": [
            "sqlite",
            "postgresql",
            "mysql"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "kits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "category",
          "businessCapability",
          "dependencies"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "displayName": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "businessCapability": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "optionalDependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "featureFlags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "frontend": {
            "type": "object"
          },
          "backend": {
            "type": "object",
            "properties": {
              "routers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "core": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "services": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "routerRegistrations": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/backendRouterRegistration"
                },
                "default": []
              },
              "middlewareRegistrations": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/backendMiddlewareRegistration"
                },
                "default": []
              }
            }
          },
          "templates": {
            "type": "object",
            "properties": {
              "backend": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "frontend": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            }
          },
          "api": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "runtimeDependencies": {
            "type": "object",
            "properties": {
              "python": { "type": "array", "items": { "type": "string" } },
              "node":   { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          },
          "database": {
            "type": "object"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "externalServices": {
            "type": "array"
          },
          "preview": {
            "type": "object",
            "properties": {
              "supportsRealtimePreview": {
                "type": "boolean"
              },
              "previewMode": {
                "type": "string"
              }
            }
          },
          "subfeatures": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/subfeature"
            },
            "default": []
          }
        }
      }
    }
  },
  "$defs": {
    "externalServiceRequirement": {
      "type": "object",
      "required": [
        "id",
        "config"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "config": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "backendRouterRegistration": {
      "type": "object",
      "required": [
        "module",
        "symbol",
        "tags"
      ],
      "properties": {
        "module": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tenantScoped": {
          "type": "boolean"
        },
        "featureFlag": {
          "type": "string"
        }
      }
    },
    "backendMiddlewareRegistration": {
      "type": "object",
      "required": [
        "module",
        "symbol"
      ],
      "properties": {
        "module": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "featureFlag": {
          "type": "string"
        }
      }
    },
    "subfeature": {
      "type": "object",
      "required": [
        "id",
        "displayName",
        "businessCapability"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "displayName": {
          "type": "string"
        },
        "businessCapability": {
          "type": "string"
        },
        "defaultSelected": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "externalServices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalServiceRequirement"
          },
          "default": []
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subfeatureOption"
          },
          "default": []
        },
        "entitlement": {
          "$ref": "#/$defs/entitlementRequirement"
        },
        "contributions": {
          "$ref": "#/$defs/subfeatureContributions"
        }
      }
    },
    "subfeatureContributions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api": { "type": "array", "items": { "type": "string" }, "default": [] },
        "featureFlags": { "type": "array", "items": { "type": "string" }, "default": [] },
        "config": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "integer", "boolean", "null"] },
          "default": {}
        },
        "frontend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pages": { "type": "array", "items": { "type": "string" }, "default": [] },
            "components": { "type": "array", "items": { "type": "string" }, "default": [] },
            "services": { "type": "array", "items": { "type": "string" }, "default": [] },
            "hooks": { "type": "array", "items": { "type": "string" }, "default": [] },
            "shellFiles": { "type": "array", "items": { "type": "string" }, "default": [] }
          }
        },
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "routers": { "type": "array", "items": { "type": "string" }, "default": [] },
            "core": { "type": "array", "items": { "type": "string" }, "default": [] },
            "services": { "type": "array", "items": { "type": "string" }, "default": [] },
            "models": { "type": "array", "items": { "type": "string" }, "default": [] },
            "routerRegistrations": {
              "type": "array",
              "items": { "$ref": "#/$defs/backendRouterRegistration" },
              "default": []
            },
            "middlewareRegistrations": {
              "type": "array",
              "items": { "$ref": "#/$defs/backendMiddlewareRegistration" },
              "default": []
            }
          }
        },
        "templates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "backend": { "type": "array", "items": { "type": "string" }, "default": [] },
            "frontend": { "type": "array", "items": { "type": "string" }, "default": [] }
          }
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "models": { "type": "array", "items": { "type": "string" }, "default": [] }
          }
        }
      }
    },
    "subfeatureOption": {
      "type": "object",
      "required": [
        "id",
        "displayName",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "displayName": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "select",
            "boolean",
            "text",
            "number"
          ]
        },
        "defaultValue": {},
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subfeatureOptionChoice"
          },
          "default": []
        }
      }
    },
    "subfeatureOptionChoice": {
      "type": "object",
      "required": [
        "value",
        "displayName"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        }
      }
    },
    "entitlementRequirement": {
      "type": "object",
      "required": [
        "requiredPlan",
        "featureKey"
      ],
      "properties": {
        "requiredPlan": {
          "type": "string"
        },
        "featureKey": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
